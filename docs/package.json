{
  "name": "hyperformula-docs",
  "private": true,
  "description": "The HyperFormula documentation portal.",
  "license": "GPL-3.0-only",
  "scripts": {
    "generate-function-docs": "ts-node --transpile-only -O {\\\"module\\\":\\\"commonjs\\\"} script/generate-builtin-functions-doc.ts",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider vuepress dev . --silent --no-clear-screen --no-cache",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vuepress build . && node script/prepare-cf-assets.js",
    "build:cf": "rimraf .vuepress/dist && npm run build",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "lint": "eslint . --ext .js,.ts",
    "preview:cf": "wrangler versions upload",
    "code-examples:generate-js": "bash code-examples-generator.sh",
    "code-examples:generate-all-js": "bash code-examples-generator.sh --generateAll",
    "code-examples:format-all-ts": "bash code-examples-generator.sh --formatAllTsExamples"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-syntax-class-properties": "^7.12.13",
    "@babel/plugin-transform-modules-commonjs": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@types/node": "^17.0.45",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vuepress/shared-utils": "^1.9.10",
    "chevrotain": "^6.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsdoc": "^50.5.0",
    "eslint-plugin-license-header": "^0.6.1",
    "eslint-plugin-prettier": "^5.2.1",
    "esm": "^3.2.25",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-regex": "^0.2.0",
    "moment": "^2.30.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.0.8",
    "vuepress": "^1.9.10",
    "vuepress-plugin-sitemap": "^2.3.1",
    "wrangler": "^4.118.0"
  }
}
