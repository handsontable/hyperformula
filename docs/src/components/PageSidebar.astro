---
/**
 * PageSidebar override, from the Handsontable docs' PageSidebar.astro: the table of contents, with
 * the page's actions below it as tertiary links:
 *
 * - Copy Markdown and View as Markdown: the page's Markdown source, served next to it (see `src/md-companions/`).
 * - Ask AI about this page: opens the docs assistant (`src/components/DocsAssistant/`) with the page named.
 * - Print this page.
 * - Open in ChatGPT and Open in Claude: a new conversation that starts by reading the page, with the prompt the
 *   Handsontable docs use (the `starlight-page-actions` default).
 */
import { Icon } from '@astrojs/starlight/components';
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
import { markdownPath as markdownPathOf } from '../page-id.mjs';

// The Markdown links show here on wide screens; PageTitle.astro shows View as Markdown where this sidebar is not
// (narrower screens, and pages without a table of contents, which get no right sidebar at all). Ask AI is in the
// header everywhere.
const { entry, toc } = Astro.locals.starlightRoute;
const markdownPath = markdownPathOf(entry);
const markdownUrl = markdownPath && `${import.meta.env.BASE_URL}${markdownPath}`;
const pageTitle = entry.data.title;
const prompt = encodeURIComponent(`Read ${Astro.url.href}. I want to ask questions about it.`);
---

{toc && (
  <>
    <div class="lg:sl-hidden">
      <MobileTableOfContents />
    </div>
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container">
        <TableOfContents />
        <div class="toc-actions">
          {markdownUrl && (
            <button class="toc-action-link" id="copy-markdown" type="button" data-path={markdownUrl}>
              <svg class="icon-default" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10" /><path d="M7 15v-6l2 2l2 -2v6" /><path d="M14 13l2 2l2 -2m-2 2v-6" /></svg>
              <Icon name="approve-check" size="0.875rem" class="icon-success" />
              <Icon name="error" size="0.875rem" class="icon-error" />
              <span>Copy Markdown</span>
            </button>
          )}
          {markdownUrl && (
            <a class="toc-action-link" href={markdownUrl}>
              <Icon name="document" size="0.875rem" />
              <span>View as Markdown</span>
            </a>
          )}
          <button class="toc-action-link" id="toc-assistant-btn" type="button" data-page-title={pageTitle}>
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12" /><path d="M9.5 9h.01" /><path d="M14.5 9h.01" /><path d="M9.5 13a3.5 3.5 0 0 0 5 0" /></svg>
            <span>Ask AI about this page</span>
          </button>
          <button class="toc-action-link" id="print-page" type="button">
            <Icon name="document" size="0.875rem" />
            <span>Print this page</span>
          </button>
          <a class="toc-action-link" href={`https://chatgpt.com/?q=${prompt}`} target="_blank" rel="noopener noreferrer" aria-label="Open in ChatGPT (opens in new window)">
            <Icon name="external" size="0.875rem" />
            <span>Open in ChatGPT</span>
          </a>
          <a class="toc-action-link" href={`https://claude.ai/new?q=${prompt}`} target="_blank" rel="noopener noreferrer" aria-label="Open in Claude (opens in new window)">
            <Icon name="external" size="0.875rem" />
            <span>Open in Claude</span>
          </a>
          <div id="copy-status" class="sr-only" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </>
)}

<script>
  // Copy Markdown: fetch the page's `.md` companion and put it on the clipboard. From the Handsontable docs.
  const copyButton = document.querySelector('#copy-markdown') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-status');

  copyButton?.addEventListener('click', async () => {
    let copyButtonClass: 'copied' | 'error' = 'copied';

    try {
      copyButton.disabled = true;

      const res = await fetch(copyButton.dataset.path!);
      if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
      await navigator.clipboard.writeText(await res.text());
      if (copyStatus) copyStatus.textContent = 'Markdown copied to clipboard';
    } catch (error) {
      console.error(error);
      copyButtonClass = 'error';
      if (copyStatus) copyStatus.textContent = 'Failed to copy Markdown';
    } finally {
      copyButton.classList.add(copyButtonClass);
      copyButton.disabled = false;

      setTimeout(() => {
        copyButton.classList.remove(copyButtonClass);
        if (copyStatus) copyStatus.textContent = '';
      }, 3000);
    }
  });

  document.getElementById('print-page')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  /* Inherit Starlight's right-sidebar-panel styles */
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 1rem var(--sl-sidebar-pad-x);
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    .right-sidebar-panel :global(h2) {
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar-panel :global(:where(a)) {
      display: block;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }
    .right-sidebar-panel :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
    @media (min-width: 72rem) {
      .sl-container {
        max-width: calc(
          (
            (
                100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
                  var(--sl-sidebar-pad-x)
              ) * 0.25
          )
        );
      }
    }
  }

  /* ── Tertiary action links below ToC ─────────────────────────────── */
  .toc-actions {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0;
    background: none;
    border: none;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s;
    line-height: 1.4;
  }

  .toc-action-link:hover {
    color: var(--sl-color-white);
  }

  /* Copy button states */
  #copy-markdown:disabled {
    opacity: 0.7;
  }

  :global(.icon-success),
  :global(.icon-error) {
    display: none;
  }

  :global(#copy-markdown.copied .icon-default),
  :global(#copy-markdown.error .icon-default) {
    display: none;
  }

  :global(#copy-markdown.copied .icon-success) {
    display: block;
  }

  :global(#copy-markdown.error .icon-error) {
    display: block;
  }
</style>
