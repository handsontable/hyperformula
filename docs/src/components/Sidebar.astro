---
/**
 * Sidebar override, following the Handsontable docs' Sidebar.astro: the sidebar shows the section of
 * the header tab the page belongs to (see Header.astro).
 *
 * - API pages: the API Reference entries only.
 * - Updates pages (release notes, migration guides): the Upgrade and migration entries only.
 * - Every other page: the guides, without those two groups.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';

const API_GROUP = 'API Reference';
const UPDATES_GROUP = 'Upgrade and migration';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const isApiPage = /^api(\.html$|\/)/.test(path);
const isUpdatesPage = /^guide\/(release-notes|migration-from-)/.test(path);

const route = Astro.locals.starlightRoute;
const groupEntries = (label: string) =>
  route.sidebar.find((entry) => entry.type === 'group' && entry.label === label)?.entries ?? [];

if (isApiPage) {
  route.sidebar = groupEntries(API_GROUP);
} else if (isUpdatesPage) {
  route.sidebar = groupEntries(UPDATES_GROUP);
} else {
  route.sidebar = route.sidebar.filter(
    (entry) => !(entry.type === 'group' && (entry.label === API_GROUP || entry.label === UPDATES_GROUP)),
  );
}
---

<Default {...Astro.props} />
