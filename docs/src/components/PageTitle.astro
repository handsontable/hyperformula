---
/**
 * PageTitle override, from the Handsontable docs' PageTitle.astro: a breadcrumb bar
 * (home › page) above the page's <h1>. The <h1> keeps id="_top", which Starlight's skip link and
 * table of contents rely on.
 */
import { markdownPath as markdownPathOf } from '../page-id.mjs';

const { entry } = Astro.locals.starlightRoute;
const pageTitle = entry.data.title;
// The page's Markdown source. PageSidebar.astro links it below the table of contents on wide screens; this
// copy covers narrower screens and pages without a table of contents.
const markdownPath = markdownPathOf(entry);
const homeLabel = `${import.meta.env.PUBLIC_HF_VERSION} HyperFormula`;
const homeHref = import.meta.env.BASE_URL;
const pageHref = Astro.url.pathname;
---

<div class="hot-page-header">
  <!-- ── Breadcrumbs ──────────────────────────────────────────────────────── -->
  <nav class="hot-breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href={homeHref} class="hot-breadcrumbs__home">
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
            <path d="M9 21V12h6v9"/>
          </svg>
          <span>{homeLabel}</span>
        </a>
      </li>
      <li aria-hidden="true" class="hot-breadcrumbs__sep">›</li>
      <li>
        <a href={pageHref} aria-current="page" class="hot-breadcrumbs__current">
          <span>{pageTitle}</span>
        </a>
      </li>
    </ol>
  </nav>
  {markdownPath && (
    <a class="hf-page-markdown" href={`${import.meta.env.BASE_URL}${markdownPath}`}>View as Markdown</a>
  )}
</div>

<div class="hot-title-row">
  <h1 id="_top">{pageTitle}</h1>
</div>

<style>
  /* ── Page title ─────────────────────────────────────────────────────────── */
  h1 {
    color: var(--sl-color-white);
  }

  .hot-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
  }


  /* ── Top bar (breadcrumbs) ───────────────────────────────────────────────── */
  .hot-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  /* ── Breadcrumbs ──────────────────────────────────────────────────────────── */
  .hot-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hot-breadcrumbs li {
    display: flex;
    align-items: center;
  }

  .hot-breadcrumbs__home {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    transition: color 0.15s;
  }

  .hot-breadcrumbs__home:hover {
    color: var(--sl-color-white);
  }

  .hot-breadcrumbs__sep {
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-sm);
    user-select: none;
  }

  .hot-breadcrumbs__current {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    cursor: default;
    pointer-events: none;
  }

  .hf-page-markdown {
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    text-decoration: none;
  }

  .hf-page-markdown:hover {
    color: var(--sl-color-white);
  }

  /* On wide screens the contents sidebar carries the link, when the page has one. */
  @media (min-width: 72rem) {
    :global(html[data-has-toc]) .hf-page-markdown {
      display: none;
    }
  }

  /* Hide breadcrumbs on mobile/tablet — sub-header already shows this info */
  @media (max-width: 71.99rem) {
    .hot-breadcrumbs {
      display: none;
    }
  }


</style>
