{
  "name": "hyperformula-monorepo",
  "description": "Monorepo for HyperFormula, its UI components, and its documentation portal.",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/handsontable/hyperformula.git"
  },
  "bugs": {
    "url": "https://github.com/handsontable/hyperformula/issues"
  },
  "homepage": "https://hyperformula.handsontable.com/",
  "author": "Handsoncode <hello@handsontable.com>",
  "workspaces": [
    "hyperformula"
  ],
  "scripts": {
    "build": "npm run bundle-all --workspace=hyperformula --",
    "bundle-all": "npm run bundle-all --workspace=hyperformula --",
    "compile": "npm run compile --workspace=hyperformula --",
    "clean": "npm run clean --workspace=hyperformula --",
    "test": "npm-run-all lint test:jest test:browser",
    "test:jest": "npm run test:jest --workspace=hyperformula --",
    "test:watch": "npm run test:watch --workspace=hyperformula --",
    "test:coverage": "npm run test:coverage --workspace=hyperformula --",
    "test:browser": "npm run test:browser --workspace=hyperformula --",
    "test:ci": "npm run test:ci --workspace=hyperformula --",
    "test:performance": "npm run test:performance --workspace=hyperformula --",
    "test:compatibility": "npm run test:compatibility --workspace=hyperformula --",
    "test:setup-private": "npm run test:setup-private --workspace=hyperformula --",
    "verify-bundles": "npm run verify-bundles --workspace=hyperformula --",
    "verify:publish-package": "npm run verify:publish-package --workspace=hyperformula --",
    "verify:typings": "npm run verify:typings --workspace=hyperformula --",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "docs:generate-function-docs": "npm --prefix docs run generate-function-docs --",
    "typedoc:build-api": "npm run typedoc:build-api --workspace=hyperformula --",
    "docs:install": "npm --prefix docs ci",
    "docs:lint": "npm --prefix docs run lint --",
    "docs:dev": "npm run docs:generate-function-docs && npm run typedoc:build-api && npm --prefix docs run dev --",
    "docs:build": "npm run docs:generate-function-docs && npm run bundle-all && npm run typedoc:build-api && npm --prefix docs run build --",
    "docs:build:cf": "npm run docs:install && npm run docs:generate-function-docs && npm run bundle-all && npm run typedoc:build-api && npm --prefix docs run build:cf --",
    "docs:dev:cf": "npm --prefix docs run dev:cf --",
    "docs:deploy:cf": "npm --prefix docs run deploy:cf --",
    "docs:preview:cf": "npm --prefix docs run preview:cf --",
    "audit": "npm audit --omit=dev",
    "check:licenses": "node script/check-licenses.mjs",
    "release": "bash script/release/release.sh"
  },
  "devDependencies": {
    "@types/node": "^17.0.45",
    "cross-env": "^7.0.3",
    "license-checker": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "^4.0.8"
  }
}
