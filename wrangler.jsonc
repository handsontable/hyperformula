/**
 * Cloudflare Workers configuration for the HyperFormula documentation site.
 *
 * The asset directory is `cf-dist/`, assembled by `script/prepare-cf-assets.js`:
 * the Astro build output copied under `cf-dist/docs/` so that every document
 * keeps the `/docs/` prefix it is served with (`base` in `docs/astro.config.mjs`),
 * with `_headers` and `_redirects` at the asset root. `worker/index.js` resolves
 * directory and extensionless URLs; see the comment there.
 *
 * Deployments are driven by Workers Builds (Git integration configured in the
 * Cloudflare dashboard):
 *   - `master`      -> `npx wrangler deploy`          (production)
 *   - other branches -> `npx wrangler versions upload` (per-branch preview URL)
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hyperformula-docs",
  "compatibility_date": "2026-07-31",
  "preview_urls": true,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./cf-dist",
    "binding": "ASSETS",
    // Both left at their defaults on purpose:
    // - `html_handling: "none"` keeps `.html` URLs from being redirected to extensionless ones,
    // - `not_found_handling: "none"` lets requests that match no asset reach `worker/index.js`.
    //   Any other value makes the asset router answer browser navigations itself (requests with
    //   `Sec-Fetch-Mode: navigate`), which would bypass the Worker and 404 every directory and
    //   extensionless URL. The Worker serves the 404 page instead.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
